# =====================================================================
# TMC QR Attendance - DEV-ONLY sample environment.
# Copy to `.env` (git-ignored):   cp .env.example .env
# Every value below is an obviously-fake demo value. NEVER reuse them
# anywhere real, and NEVER put real credentials in this file.
# docker-compose.yml has the same defaults, so the stack also starts
# without a .env - the file only exists so you can override things.
# =====================================================================

# --- central PostgreSQL (shared by the 4 central services) -----------
POSTGRES_DB=tmc
POSTGRES_USER=tmc_app
POSTGRES_PASSWORD=dev-only-change-me

# --- host port mapping (internal container ports are fixed) ----------
GATEWAY_HOST_PORT=8080
FRONTEND_HOST_PORT=3000
KIOSK_HOST_PORT=8085
MOCK_TURNSTILE_HOST_PORT=8090
MOCK_HR_HOST_PORT=8091
# All published ports are bound to 127.0.0.1 only (the dev endpoints are unauthenticated).
# 5433 on the host (not 5432) because a local PostgreSQL usually already owns 5432.
# Containers still reach the database at central-db:5432 inside the Compose network.
DB_HOST_PORT=5433

# --- kiosk identity (config-driven, NFR-5) ---------------------------
KIOSK_ID=BD-K01
KIOSK_FACTORY_ID=BD

# --- offline simulation (D05) ----------------------------------------
# true  => kiosk stops talking to central ONLY. Local mock turnstile still works.
CENTRAL_SYNC_DISABLED=false

# --- mock HR failure injection (D09) ---------------------------------
# 0 = healthy, otherwise the HTTP status the mock returns (e.g. 500 or 503)
SIMULATE_HR_DOWN=0

# --- JVM heap cap (dev tuning only, NOT a container-RAM claim - D15) --
JAVA_TOOL_OPTIONS=-Xms64m -Xmx192m
